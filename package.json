{
  "name": "rouvix-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "nxgt-graphql-scalars typedefs --out && nxgt-graphql-validation typedefs --out && graphql-codegen --config codegen.ts",
    "dev": "NODE_ENV=development bun --watch src/server.ts",
    "services:up": "docker compose up -d --wait mongo redis s3 && docker compose run --rm mongo-init",
    "services:down": "docker compose down",
    "build": "bun run generate && bun build src/server.ts --target=bun --outdir=dist --minify --sourcemap=linked --external @softistx/mail",
    "start": "NODE_ENV=production bun dist/server.js",
    "db:sync": "bun src/scripts/db-sync.ts",
    "db:migrate": "bun src/scripts/db-migrate.ts",
    "admin:create": "bun src/scripts/admin-create/index.ts",
    "schema:print": "bun src/scripts/schema-print.ts",
    "test": "bun test --timeout=15000",
    "typecheck": "bun check",
    "lint": "biome lint",
    "format": "biome format --write",
    "fix": "biome check --write",
    "check:ci": "biome ci",
    "verify": "bun run generate && bun run schema:print --check && bun run check:ci && bun run typecheck && bun run test"
  },
  "dependencies": {
    "@graphql-tools/load-files": "^7.0.1",
    "@graphql-tools/merge": "^9.2.6",
    "@graphql-tools/utils": "^12.0.3",
    "@softistx/alxia": "^0.28.0",
    "@softistx/alxia-env": "^0.6.0",
    "@softistx/alxia-graphql": "^0.20.1",
    "@softistx/alxia-i18n": "^0.7.0",
    "@softistx/alxia-media": "^0.12.0",
    "@softistx/graphql-scalars": "^0.8.0",
    "@softistx/graphql-validation": "^0.10.0",
    "@softistx/graxia": "^0.17.2",
    "@softistx/i18n": "^3.2.2",
    "@softistx/image": "^0.6.1",
    "@softistx/janus": "^0.81.0",
    "@softistx/janus-mongo": "^0.33.0",
    "@softistx/mail": "^1.6.1",
    "@softistx/mail-smtp": "^1.1.1",
    "@softistx/mongo": "^0.30.1",
    "@softistx/redis": "^0.24.0",
    "graphql": "^17.1.0",
    "mongodb": "^7.9.1",
    "nodemailer": "^10.6.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@graphql-codegen/cli": "7.4.5",
    "@graphql-codegen/client-preset": "6.2.3",
    "@graphql-codegen/typescript": "6.1.1",
    "@graphql-codegen/typescript-resolvers": "6.1.1",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@softistx/graphql-codegen-zod": "^0.6.0",
    "@types/bun": "^1.4.5",
    "@types/nodemailer": "^8.0.2",
    "mongodb-memory-server-core": "^11.4.0",
    "typescript": "^7.0.2"
  }
}
