"""
Where a page of a list ends. Paging is forward only: `endCursor` is the
`after` of the next page; to go back, a client keeps the cursors it has
visited. `startCursor` is the `after` this page was asked with, and
`hasPreviousPage` says whether it was given.
"""
type PageInfo {
  startCursor: String
  endCursor: String
  hasNextPage: Boolean!
  hasPreviousPage: Boolean!
}

"""
The direction of a sort. ASC is the order the sorted field documents as its
own; DESC is its exact reverse, ties included.
"""
enum SortDirection {
  "The documented order."
  ASC
  "The reverse of the documented order."
  DESC
}

"The language of an account and of its messages."
enum Language {
  FR
  EN
}
