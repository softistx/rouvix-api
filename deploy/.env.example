# Copy to deploy/.env (mode 600, never committed). Every CHANGE_ME is a secret
# to generate (openssl rand -base64 32; the keyfile and the proxy secret need
# the lengths below). Fake values only in this public file.

# The UI's public hostname: links in mails start with it.
UI_HOSTNAME=rouvix.example.com
MAIL_FROM=no-reply@rouvix.example.com
MAIL_URL=smtps://user:CHANGE_ME@smtp.example.com:465

# The docker network rouvix-ui's container also joins (create it once:
# docker network create rouvix-edge).
EDGE_NETWORK=rouvix-edge

# 32 characters or more, the same value as the UI's API_PROXY_SECRET.
API_PROXY_SECRET=CHANGE_ME

# Africa's Talking, which sends the sign-in code.
AT_USERNAME=CHANGE_ME
AT_API_KEY=CHANGE_ME
AT_SENDER_ID=ROUVIX

# The User-Agent Nominatim's usage policy requires: the application and a contact.
GEOCODER_USER_AGENT=rouvix-api/1.0 (contact: ops@rouvix.example.com)

# The User-Agent Nominatim's usage policy requires: the application and a contact.
GEOCODER_USER_AGENT=rouvix-api/1.0 (contact: ops@rouvix.example.com)

MONGO_ROOT_PASSWORD=CHANGE_ME
# openssl rand -base64 756 | tr -d '\n' (6 to 1024 base64 characters)
MONGO_KEYFILE=CHANGE_ME
MONGO_APP_PASSWORD=CHANGE_ME
MONGO_MIGRATE_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
